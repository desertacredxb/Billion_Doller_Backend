# Keep disabled until both repositories are deployed and the selected integration is tested.
VERIFF_ENABLED=false
VERIFF_MODE=test
# Copy the exact base URL from the selected integration's API Keys page.
VERIFF_BASE_URL=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_CALLBACK_URL=https://billiondollarfx.com/verify-identity
# Use fullauto only for the Veriff Essential / Full Auto product.
VERIFF_WEBHOOK_TYPE=decision
